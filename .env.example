# DealForge AI - Environment Configuration Template
# Copy this file to .env and configure appropriate values

# Server Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000

# Security & Session Secrets (Replace with cryptographically random 64-char hex strings in production)
JWT_SECRET=dealforge_dev_jwt_secret_super_secure_key_change_in_production_9080
SESSION_EXPIRY=7d

# Database Configuration
DB_TYPE=file_storage
DB_PATH=./data/dealforge.json

# Stripe Test Mode Credentials
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_51MockStripeSecretKeyForDealForgeDevTestingOnly123456789
STRIPE_PUBLISHABLE_KEY=pk_test_51MockStripePublishableKeyForDealForgeDevTestingOnly123456789
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook_signing_secret_test_suite_9080

# AI Scope Engine Configuration
AI_ENGINE_PROVIDER=local_heuristic
OPENAI_API_KEY=mock_openai_api_key_optional_for_advanced_llm_inference

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
